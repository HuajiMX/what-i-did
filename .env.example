# 复制为 .env 后修改。.env 已被 .gitignore 排除，不会进版本库。

# 监听端口
PORT=8787
# 监听地址。默认 127.0.0.1（只允许本机/反向代理访问）；
# 若不用反向代理、希望局域网直接访问，改为 0.0.0.0
HOST=127.0.0.1

# SQLite 数据库文件路径（相对路径按进程工作目录解析）
DB_PATH=./data/what-i-did.db

# 会话签名密钥。必须改成一个长随机串，否则服务启动会拒绝运行。
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 管理员密码哈希。生成方法：npm run hash-password -- '你的密码'
# 服务端只存哈希，不存明文。
ADMIN_PASSWORD_HASH=

# 会话有效期（天）
SESSION_DAYS=30

# 是否给会话 cookie 加 Secure 属性。
# 走 HTTPS（含反向代理终止 TLS）时保持 true；
# 本机 http://127.0.0.1 调试时设为 false，否则浏览器不会保存 cookie。
COOKIE_SECURE=true
